# Smiles By Jiveh: static Next.js export on SiteGround (Apache).
# Redirects, security headers and caching (what a Node server would do).

Options -Indexes
DirectoryIndex index.html index.php
# The trailing slash is added by a rewrite below (on https), not by Apache.
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One address: https://smilesbyjiveh.com (no www), as the old site.
  # (turn on "HTTPS Enforce" in SiteGround Site Tools > Security > SSL Manager too)
  RewriteCond %{HTTP_HOST} ^www\.smilesbyjiveh\.com$ [NC]
  RewriteRule ^(.*)$ https://smilesbyjiveh.com/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} ^smilesbyjiveh\.com$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://smilesbyjiveh.com/$1 [R=301,L]

  # Old WordPress URLs that changed. Targets keep the visitor's host so a
  # staging domain stays on staging.
  RewriteRule ^appoinment/?$ /appointment/ [R=301,L]
  # WordPress leftovers: feeds, sitemap and the REST API go home or 410.
  RewriteRule ^(feed|comments/feed)/?$ / [R=301,L]
  RewriteRule ^wp-sitemap\.xml$ /sitemap.xml [R=301,L]
  RewriteRule ^sitemap_index\.xml$ /sitemap.xml [R=301,L]
  RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php|wp-json)(/.*)?$ - [G,L]

  # Pages live at /page/ (page/index.html): add the missing slash.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ /$1/ [R=301,L]

  # The Sanity Studio is one page; its inner URLs (/cms/structure/...) load it.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^cms/. /cms/index.html [L]
</IfModule>

# The form's settings file and the upload tool's file list are never served.
<FilesMatch "^(lead-config\.php|\.ftp-deploy-sync-state\.json)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), browsing-topics=()"
  # No includeSubDomains: other subdomains (mail, GoHighLevel links) are not ours to force.
  Header always set Strict-Transport-Security "max-age=31536000"

  # Any address other than the real one (a preview subdomain, the SiteGround
  # temporary domain) is kept out of Google, so it never competes with the live site.
  <If "%{HTTP_HOST} !~ /^(www\.)?smilesbyjiveh\.com$/i">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>

  # Strict CSP for the site. Third parties: Google tag / Tag Manager, the
  # YouTube hero video, Google Maps, the Elfsight Google reviews widget, Sanity
  # images and the GoHighLevel (LeadConnector) chat widget. If you add tags in
  # GTM that load other scripts, add their domains here.
  # The studio at /cms talks to many Sanity hosts and is protected by Sanity login instead.
  <If "%{REQUEST_URI} !~ m#^/cms(/|$)#">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://*.googletagmanager.com https://www.google-analytics.com https://*.elfsightcdn.com https://elfsightcdn.com https://*.elfsight.com https://*.leadconnectorhq.com https://*.msgsndr.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://*.elfsightcdn.com https://*.leadconnectorhq.com https://*.msgsndr.com https://fonts.googleapis.com https://fonts.bunny.net; img-src 'self' data: blob: https:; font-src 'self' data: https://*.elfsightcdn.com https://*.leadconnectorhq.com https://*.msgsndr.com https://fonts.gstatic.com https://fonts.bunny.net; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.elfsight.com https://*.elfsightcdn.com https://*.leadconnectorhq.com https://*.msgsndr.com wss://*.leadconnectorhq.com https://*.googleapis.com https://challenges.cloudflare.com; frame-src 'self' https://www.youtube-nocookie.com https://www.youtube.com https://www.googletagmanager.com https://www.google.com https://maps.google.com https://*.elfsight.com https://*.leadconnectorhq.com https://*.msgsndr.com https://challenges.cloudflare.com; media-src 'self' blob: https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  </If>

  # Caching: hashed build files forever, photos for a month, pages always fresh.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|avif|jpe?g|png|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>
