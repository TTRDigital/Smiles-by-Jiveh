{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.mjs",
  "outputDirectory": "public",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/", "has": [{ "type": "host", "value": "offer.smilesbyjiveh.com" }], "destination": "/offer/index.html" },
    { "source": "/", "has": [{ "type": "host", "value": "implant.smilesbyjiveh.com" }], "destination": "/implant/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    },
    {
      "source": "/(shared|offer|implant)/(.*)\\.(jpg|png|mp4)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=31536000, stale-while-revalidate=604800" }]
    }
  ]
}
