# Copy to .env.local for local development. The NEXT_PUBLIC_ values are read
# at build time (static export). Never commit real values.

# --- Sanity (project 3wz2011s / production are the defaults in sanity/env.ts)
NEXT_PUBLIC_SANITY_PROJECT_ID=3wz2011s
NEXT_PUBLIC_SANITY_DATASET=production
# Only for `npm run seed` on your machine (Editor token from sanity.io/manage > API > Tokens).
SANITY_WRITE_TOKEN=

# --- Site
NEXT_PUBLIC_SITE_URL=https://smilesbyjiveh.com

# --- GoHighLevel
# The form's webhook is NOT set here: it lives in api/lead-config.php on
# SiteGround, written by the deploy workflow from the GHL_WEBHOOK_URL secret.
# Website chat widget ID (Sites > Chat Widget > Get code: data-widget-id). Empty = chat hidden.
NEXT_PUBLIC_GHL_CHAT_WIDGET_ID=

# --- Google (from the old site: Site Kit's Google tag and Tag Manager; these are the defaults, "off" disables)
NEXT_PUBLIC_GA_ID=GT-TBVN7SPV
NEXT_PUBLIC_GTM_ID=GTM-KW9CW8P7
